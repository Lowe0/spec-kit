{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec draft",
  "description": "A proposed living feature specification produced from a spec request.",
  "$defs": {
    "repoRelativeSpecPath": {
      "type": "string",
      "description": "A repository-relative path ending in spec.md.",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?:[^/]+/)*spec\\.md$"
    }
  },
  "oneOf": [
    {
      "title": "Draft produced",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "spec_path", "specification", "questions", "assumptions"],
      "properties": {
        "status": {"const": "draft"},
        "spec_path": {"$ref": "#/$defs/repoRelativeSpecPath"},
        "specification": {"type": "string", "minLength": 1},
        "questions": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    {
      "title": "Request requires clarification",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "questions"],
      "properties": {
        "status": {"const": "needs_input"},
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    }
  ]
}
