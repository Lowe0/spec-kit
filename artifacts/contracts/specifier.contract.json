{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specifier contract",
  "description": "The input and output boundary for the specify operation.",
  "$defs": {
    "repoRelativeSpecPath": {
      "type": "string",
      "description": "A repository-relative path ending in spec.md.",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?:[^/]+/)*spec\\.md$"
    }
  },
  "oneOf": [
    {
      "title": "Input",
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": {
          "type": "string",
          "minLength": 1,
          "description": "The user's freeform project request."
        },
        "context": {
          "type": "string",
          "description": "Relevant project context, if available."
        },
        "existing_spec_path": {
          "$ref": "#/$defs/repoRelativeSpecPath"
        }
      }
    },
    {
      "title": "Successful output",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "spec_path", "specification", "questions", "assumptions"],
      "properties": {
        "status": {"const": "accepted"},
        "spec_path": {"$ref": "#/$defs/repoRelativeSpecPath"},
        "specification": {"type": "string", "minLength": 1},
        "questions": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    {
      "title": "Input requiring clarification",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "questions"],
      "properties": {
        "status": {"const": "needs_input"},
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    }
  ]
}
